{
  "expo": {
    "name": "DailyReps",
    "slug": "dailyreps",
    "scheme": "dailyreps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B17",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dailyreps.app",
      "adaptiveIcon": {
        "backgroundColor": "#4746D0",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-screen.png",
          "imageWidth": 220,
          "backgroundColor": "#4746D0"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4746D0"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4f69b009-d240-43bc-bbb2-dc9192673f49"
      }
    },
    "owner": "sukeshv19"
  }
}
